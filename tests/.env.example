# Copy to .env (git-ignored) for local runs. In CI these come from repository secrets.

# Deployed app, with trailing slash
APP_BASE_URL=https://<your-personal-env>.outsystemscloud.com/MSFSupportFinder/

# Test users created in the Users application, one per role
OFFICER_USERNAME=officer1
OFFICER_PASSWORD=
SUPERVISOR_USERNAME=supervisor1
SUPERVISOR_PASSWORD=
ADMIN_USERNAME=admin1
ADMIN_PASSWORD=

# Optional: data.gov.sg API key for higher rate limits
DATAGOV_API_KEY=
