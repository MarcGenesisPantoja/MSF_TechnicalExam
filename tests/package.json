{
  "name": "supportfinder-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Contract and end-to-end tests for the SupportFinder OutSystems application",
  "scripts": {
    "test": "playwright test",
    "test:contract": "playwright test --project=contract",
    "test:offline": "playwright test --project=contract fixtures.spec.ts",
    "test:e2e": "playwright test --project=e2e",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}
